{
  "name": "iterm-web",
  "version": "0.1.0",
  "description": "Your iTerm2 tabs and Claude Code sessions on your phone, over Tailscale.",
  "keywords": [
    "iterm2",
    "claude",
    "claude-code",
    "terminal",
    "tailscale",
    "mobile",
    "pwa",
    "macos"
  ],
  "license": "MIT",
  "author": "Bruno Bornsztein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bborn/iterm-web.git"
  },
  "homepage": "https://github.com/bborn/iterm-web#readme",
  "bugs": "https://github.com/bborn/iterm-web/issues",
  "type": "module",
  "bin": {
    "iterm-web": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/cli.ts start --demo\" \"vite\"",
    "demo": "npm run build && node dist/cli.js start --demo",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "protobufjs": "^8.8.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
